<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_m">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/compare_title"
            android:textAppearance="?attr/textAppearanceTitleLarge" />

        <TextView
            android:id="@+id/tvCompareStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:text="@string/compare_loading" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Porto -->
            <LinearLayout
                android:id="@+id/cardPorto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/upt_light"
                android:orientation="vertical"
                android:padding="@dimen/spacing_s">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/compare_porto"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/upt_navy" />

                <TextView
                    android:id="@+id/tvPortoMax"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:textColor="@color/upt_navy" />

                <TextView
                    android:id="@+id/tvPortoMin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/upt_navy" />

                <TextView
                    android:id="@+id/tvPortoRain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/upt_navy" />
            </LinearLayout>

            <!-- Lisboa -->
            <LinearLayout
                android:id="@+id/cardLisboa"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_s"
                android:background="@color/upt_light"
                android:orientation="vertical"
                android:padding="@dimen/spacing_s">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/compare_lisboa"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/upt_navy" />

                <TextView
                    android:id="@+id/tvLisboaMax"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:textColor="@color/upt_navy" />

                <TextView
                    android:id="@+id/tvLisboaMin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/upt_navy" />

                <TextView
                    android:id="@+id/tvLisboaRain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/upt_navy" />
            </LinearLayout>

            <!-- Faro -->
            <LinearLayout
                android:id="@+id/cardFaro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_s"
                android:background="@color/upt_light"
                android:orientation="vertical"
                android:padding="@dimen/spacing_s">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/compare_faro"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/upt_navy" />

                <TextView
                    android:id="@+id/tvFaroMax"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:textColor="@color/upt_navy" />

                <TextView
                    android:id="@+id/tvFaroMin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/upt_navy" />

                <TextView
                    android:id="@+id/tvFaroRain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/upt_navy" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>